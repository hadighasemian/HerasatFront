# Copy to .env.production (used by `npm run build` AND `npm start`).
# NOTE: BACKEND_URL is baked into the build (rewrites) – rebuild after changing it.

# Laravel API as seen from the Next.js server (not from the browser)
BACKEND_URL=http://127.0.0.1:8000

# Leave empty: the browser calls the API same-origin through the Next.js proxy
NEXT_PUBLIC_API_URL=

# Must equal SESSION_COOKIE in back/.env (used to gate /dashboard before rendering)
SESSION_COOKIE_NAME=herasat_session

# Only when the site is served over HTTPS
ENABLE_HSTS=false
CSP_UPGRADE_INSECURE=false

# server.mjs
PORT=3000
HOST=0.0.0.0
# IPs of a reverse proxy in front of Next.js (e.g. IIS/Apache), if any. Otherwise leave empty.
TRUSTED_UPSTREAM_PROXIES=
